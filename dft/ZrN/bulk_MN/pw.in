&CONTROL
   calculation      = 'vc-relax'
   restart_mode     = 'from_scratch'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './out'
   prefix           = 'pw'
   pseudo_dir       = './pseudo'
/
&SYSTEM
   ibrav            = 0
   nat              = 8
   ntyp             = 2
   ecutwfc          = 60.0
   ecutrho          = 480.0
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'cold'
/
&ELECTRONS
   conv_thr         = 1e-07
   mixing_beta      = 0.3
/
&IONS
   ion_dynamics     = 'bfgs'
/
&CELL
   cell_dofree      = 'all'
/
&FCP
/
&RISM
/
